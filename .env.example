# ====================================================================
# LLM RED TEAM PLAYGROUND - .env.example
# ====================================================================
# Copia este archivo a .env y pega tus claves.
# Deja en blanco las que no uses: el adaptador las ignora y salta
# al siguiente proveedor de la cadena de fallback.
# ====================================================================

# ====================================================================
# 1) GOOGLE GEMINI (opcional)
# ====================================================================
# Clave: https://aistudio.google.com/app/apikey
# Free tier: ~20 req/día. La cuota es POR PROYECTO (no por clave).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ====================================================================
# 2) GROQ  ⭐ recomendado para trabajar a 0 USD
# ====================================================================
# Clave: https://console.groq.com/keys  (gratis, sin tarjeta)
# Free tier generoso (miles de req/día), sin tarjeta de crédito
GROQ_API_KEY=
# Modelos verificados que SÍ existen en tu cuenta (usa uno de estos):
#   openai/gpt-oss-120b         ← recomendado (general, ~2 s por respuesta)
#   openai/gpt-oss-20b          ← el más rápido (~1 s), algo menos preciso
#   qwen/qwen3.8-27b            ← rápido y muy buen multilingüe
# Los meta-llama/llama-prompt-guard-* NO sirven aquí: son clasificadores
# de seguridad y rechazan peticiones con max_tokens alto (error 400).
GROQ_MODEL=openai/gpt-oss-120b
# URL del endpoint (solo si usas proxy o gateway propio)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ====================================================================
# 3) OPENROUTER (opcional, fallback adicional)
# ====================================================================
# Clave: https://openrouter.ai/keys
# Free tier: ~50 req/día usando modelos ":free". Los :free rotan, si
# uno falla usa liquid/lfm-2.5-2.6b:free o consulta openrouter.ai/models?q=free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ====================================================================
# 4) OMNIROUTE (opcional, gateway local)
# ====================================================================
# https://github.com/diegosouzapw/OmniRoute
# Endpoint compatible con OpenAI en localhost:20128/v1.
# Con OMNIROUTE_MODEL=auto el gateway elige el mejor backend disponible.
OMNIROUTE_API_KEY=omniroute
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto

# ====================================================================
# 5) OLLAMA / LM STUDIO (opcional, local y sin cuota)
# ====================================================================
# ollama serve  &&  ollama pull qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# ====================================================================
# COMPORTAMIENTO DEL ADAPTADOR (src/llm_client.py)
# ====================================================================

# auto = recorre LLM_FALLBACK_ORDER hasta que uno responda.
# También admite un proveedor fijo: gemini | groq | openrouter |
# omniroute | ollama
LLM_PROVIDER=auto

LLM_FALLBACK_ORDER=gemini,groq,openrouter,omniroute,ollama

# Segundos de espera por petición
LLM_TIMEOUT=30

# Reintentos por proveedor ANTES de pasar al siguiente
LLM_MAX_ATTEMPTS=2

# Tope de tokens por respuesta
LLM_MAX_TOKENS=2048

# 1 = pide razonamiento paso a paso y extrae <final>...</final>
LLM_COT=1